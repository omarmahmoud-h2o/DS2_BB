<diagram name="v1 – Generic framework (draft)" id="fw-v1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Synthetic Data Generation Framework — Draft Architecture v1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Generic across use cases · FAG is the first task spec and the pipeline's test case&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1480" height="40" as="geometry"/></mxCell><mxCell id="bg_pre" value="PRE-PREPARATION (outside the framework, for now)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;dashed=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1120" height="110" as="geometry"/></mxCell><mxCell id="bg_fw" value="FRAMEWORK" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=right;spacingRight=12;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="1480" height="1445" as="geometry"/></mxCell><mxCell id="bg0" value="0 · TASK INTAKE" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="1100" height="160" as="geometry"/></mxCell><mxCell id="bg1" value="1 · COVERAGE PLAN" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="60" y="395" width="1100" height="160" as="geometry"/></mxCell><mxCell id="bg2" value="2 · GENERATE (agentic)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="60" y="575" width="1100" height="170" as="geometry"/></mxCell><mxCell id="bg3" value="3 · VALIDATION CASCADE — cheapest first, stop at first hard failure" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="60" y="765" width="1100" height="320" as="geometry"/></mxCell><mxCell id="bg4" value="4 · DATASET EVALUATION" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="60" y="1105" width="1100" height="150" as="geometry"/></mxCell><mxCell id="bg5" value="5 · RELEASE GATE" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="60" y="1275" width="1100" height="180" as="geometry"/></mxCell><mxCell id="bgside" value="SHARED REGISTRIES &amp;amp; STORES" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fcfcfc;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="1185" y="215" width="320" height="1240" as="geometry"/></mxCell><mxCell id="raw" value="Raw seeds&lt;br&gt;(may contain real data)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="100" y="85" width="170" height="55" as="geometry"/></mxCell><mxCell id="obf" value="Obfuscation / anonymisation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="340" y="85" width="220" height="55" as="geometry"/></mxCell><mxCell id="clean" value="Clean seeds" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="630" y="85" width="160" height="55" as="geometry"/></mxCell><mxCell id="e_raw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="raw" target="obf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_obf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="obf" target="clean"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="spec" value="&lt;b&gt;task.yaml&lt;/b&gt; (declarative)&lt;br&gt;task type · description · output schema · rubric/policies (+ reason if required) · seeds · tools · coverage axes · targets · thresholds · HITL switches · model per stage" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="330" height="105" as="geometry"/></mxCell><mxCell id="hooks" value="&lt;b&gt;hooks.py&lt;/b&gt; (optional code)&lt;br&gt;label_rule · extra_validators · sampler_constraints · post_process&lt;br&gt;&lt;i&gt;e.g. FAG expected_breach()&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="250" width="230" height="105" as="geometry"/></mxCell><mxCell id="intake" value="&lt;b&gt;Spec validation&lt;/b&gt;&lt;br&gt;spec well-formed · seeds re-scanned for PII (reject if not clean) · tools exist in registry · thresholds set" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="260" width="300" height="85" as="geometry"/></mxCell><mxCell id="e_clean" value="seeds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="clean" target="spec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_spec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="spec" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_hooks" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="hooks" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="kw" value="&lt;b&gt;Keyword expansion&lt;/b&gt;&lt;br&gt;seed → ↑ advanced / ↓ prerequisite&lt;br&gt;+ retrieval-augmented extraction" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="430" width="290" height="95" as="geometry"/></mxCell><mxCell id="axes" value="&lt;b&gt;Task-type axes&lt;/b&gt;&lt;br&gt;Bloom level · difficulty · label · stance · length …" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="240" height="95" as="geometry"/></mxCell><mxCell id="grid" value="&lt;b&gt;Coverage grid&lt;/b&gt;&lt;br&gt;cells × quotas&lt;br&gt;&lt;i&gt;coverage_plan.json (cached by spec version)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="430" width="270" height="95" as="geometry"/></mxCell><mxCell id="h_plan" value="◆ HITL&lt;br&gt;approve / edit plan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="990" y="440" width="150" height="75" as="geometry"/></mxCell><mxCell id="e_intake_kw" value="compiled spec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="intake" target="kw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_kw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="kw" target="axes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_axes" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="axes" target="grid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_hplan" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;startArrow=classic;" edge="1" parent="1" source="grid" target="h_plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sched" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;picks cell furthest below quota ·&lt;br&gt;stops a cell once quota is met" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="615" width="270" height="95" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;Generator LLM agent&lt;/b&gt;&lt;br&gt;(local vLLM / MLX or API)&lt;br&gt;decides its own tool calls" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="615" width="250" height="95" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Tool gateway&lt;/b&gt;&lt;br&gt;task allowlist · per-record call/token budget · sensitivity label on results · response cache · full trace log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="610" width="300" height="105" as="geometry"/></mxCell><mxCell id="e_grid_sched" value="cells + quotas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="grid" target="sched"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_sched_gen" value="scenario / cell" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="sched" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gen_gw" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;startArrow=classic;" edge="1" parent="1" source="gen" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1" value="&lt;b&gt;L1 Schema / layout&lt;/b&gt;&lt;br&gt;output schema,&lt;br&gt;structure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="805" width="155" height="95" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;L2 Rules &amp;amp; keywords&lt;/b&gt;&lt;br&gt;spec rules + hooks&lt;br&gt;(e.g. verbatim spans)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="255" y="805" width="155" height="95" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;L3 Governance&lt;/b&gt;&lt;br&gt;PII · toxicity · secrets ·&lt;br&gt;tool-data leakage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="805" width="155" height="95" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;L4 Overlap&lt;/b&gt;&lt;br&gt;seeds · held-out set ·&lt;br&gt;near-duplicates" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="605" y="805" width="155" height="95" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;L5 LLM judge&lt;/b&gt;&lt;br&gt;decision SLM ≠ generator&lt;br&gt;verdict + rubric scores&lt;br&gt;blind to intended label" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="805" width="155" height="95" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;L6 Consistency&lt;/b&gt;&lt;br&gt;K votes — only on&lt;br&gt;escalated cases" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="955" y="805" width="155" height="95" as="geometry"/></mxCell><mxCell id="e_l1_l2" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l2_l3" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l3_l4" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l4_l5" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l5_l6" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gen_l1" value="candidate record + tool trace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" edge="1" parent="1" source="gen" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="failbar" value="on FAIL — first failing layer stops the cascade" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fontColor=#b85450;fillColor=#fff5f5;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="925" width="1030" height="26" as="geometry"/></mxCell><mxCell id="e_l1_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l1" target="failbar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l2_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l2" target="failbar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l3_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l3" target="failbar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l4_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l4" target="failbar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l5_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l5" target="failbar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l6_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l6" target="failbar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="repair" value="&lt;b&gt;Repair&lt;/b&gt;&lt;br&gt;validator error fed back to generator&lt;br&gt;(≤ N tries, same cell)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="990" width="260" height="70" as="geometry"/></mxCell><mxCell id="drop" value="&lt;b&gt;Drop + log reason&lt;/b&gt;&lt;br&gt;per cell &amp;amp; per layer (drives error rate)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="990" width="260" height="70" as="geometry"/></mxCell><mxCell id="queue" value="◆ HITL &lt;b&gt;Review queue&lt;/b&gt;&lt;br&gt;judge disagreement / low rubric score" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="990" width="300" height="70" as="geometry"/></mxCell><mxCell id="e_fail_repair" value="quality fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="failbar" target="repair"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fail_drop" value="governance fail /&lt;br&gt;tries exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="failbar" target="drop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fail_queue" value="low confidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="failbar" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_repair_sched" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="repair" target="sched"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="1025"/><mxPoint x="70" y="682"/></Array></mxGeometry></mxCell><mxCell id="models" value="&lt;b&gt;Model registry&lt;/b&gt; (per stage)&lt;br&gt;generator: local vLLM / MLX / API&lt;br&gt;judge: decision SLM — low cost, low latency&lt;br&gt;&lt;i&gt;(candidate: Jev-ai or open-source equivalent)&lt;/i&gt;&lt;br&gt;expansion: small model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1205" y="250" width="280" height="120" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Tool registry&lt;/b&gt;&lt;br&gt;pre-defined tools per task · sensitivity level · read-only by default" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1205" y="395" width="280" height="80" as="geometry"/></mxCell><mxCell id="govp" value="&lt;b&gt;Governance profile&lt;/b&gt;&lt;br&gt;global rules + per-task tightening: PII patterns · toxicity · entity allow/deny · allowed model endpoints per data class" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1205" y="500" width="280" height="100" as="geometry"/></mxCell><mxCell id="accepted" value="&lt;b&gt;Accepted records&lt;/b&gt;&lt;br&gt;+ provenance: spec